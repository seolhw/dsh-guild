{
  "name": "dsh-guild",
  "version": "0.0.3",
  "packageManager": "pnpm@12.3.4",
  "description": "DSH-Guild",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seolhw/dsh-guild.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node ./scripts/dev.mjs",
    "dev:server": "pnpm --filter @dsh-guild/server dev",
    "deploy:server": "pnpm --filter @dsh-guild/server run deploy",
    "docs:dev": "pnpm --filter @dsh-guild/website dev",
    "docs:build": "pnpm --filter @dsh-guild/website build",
    "docs:preview": "pnpm --filter @dsh-guild/website preview",
    "docs:deploy": "pnpm --filter @dsh-guild/website deploy:pages",
    "update": "npx npm-check-updates -u --target greatest --dep peer @deepseek-ai/*",
    "typecheck": "pnpm -r run typecheck && pnpm typecheck:plugin && pnpm typecheck:client",
    "typecheck:types": "tsc -p packages/types/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p packages/server/tsconfig.json --noEmit",
    "typecheck:plugin": "tsc -p packages/host/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p packages/client/tsconfig.json --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "check:ci": "biome ci ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0"
  }
}