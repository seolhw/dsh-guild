// ================================================================
// DSH-Guild Server Wrangler 配置（JSONC 格式，Cloudflare 推荐）
// 与旧 wrangler.toml 等价；JSON 配置可注释、支持部分只在 JSON 提供的新特性。
// 本地：pnpm dev (wrangler dev --ip 127.0.0.1，显式绑定 IPv4 回环，
//       避免 localhost 解析到 ::1 导致浏览器走 127.0.0.1 连不上)
// 部署：pnpm deploy (wrangler deploy)
// ================================================================
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-guild",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // ---------- 本地开发（wrangler dev --port 8787） ----------
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },
  "routes": [
    {
      "pattern": "dsh-guild-api.huiwang.fun",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  // ---------- D1：元数据库（社区/频道/消息/分享；用户等认证实体由 Better Auth 建表） ----------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsh-guild",
      "database_id": "bf484786-2523-4e50-a81d-7bca302e9409",
      // drizzle-kit 生成的 SQL 迁移目录（wrangler d1 migrations apply 使用）
      "migrations_dir": "drizzle"
    }
  ],
  // ---------- R2：附件 / 会话克隆包 / workflow 载荷 ----------
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "dsh-guild-assets",
      "preview_bucket_name": "dsh-guild-assets-local"
    }
  ],
  // ---------- Durable Object：ChannelActor（一个频道 = 一个 DO 实例，实时广播） ----------
  // Free 计划只能用 SQLite 后端 DO。用新式声明式 exports（wrangler 4 推荐）：
  //   类在代码中 export，storage:"sqlite" 表示 SQLite 后端；删除旧 migrations。
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_ACTOR",
        "class_name": "ChannelActor"
      }
    ]
  },
  "exports": {
    "ChannelActor": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // ---------- 环境变量 ----------
  // 敏感凭据（BETTER_AUTH_SECRET / RESEND_API_KEY）生产用 wrangler secret put；
  // 非敏感的认证地址直接声明在下方 vars，随 pnpm deploy 生效。
  // 本地 pnpm dev 会自动把根 .env 同步到 .dev.vars，其同名值会覆盖这里的 vars。
  // 其余业务策略均为代码常量（见 src/constants.ts 与 src/lib/auth.ts）。
  "vars": {
    // 生产认证对外地址（自定义域）：Better Auth 的 baseURL 固定为它，
    // 邮箱验证 / 重置链接都基于它，且不再按请求 Host 做白名单校验。
    // 自定义域有变动时必须同步更新这里，否则生产请求会因 Host 不在允许名单而 500。
    "BETTER_AUTH_URL": "https://dsh-guild-api.huiwang.fun"
  }
}
