{
  "name": "@dsh-guild/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH-Guild 文档站（VitePress）",
  "scripts": {
    "dev": "vitepress dev . --port 5180",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "deploy:pages": "vitepress build . && wrangler pages deploy .vitepress/dist --project-name=dsh-guild-docs --branch=main --commit-dirty=true"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.20",
    "wrangler": "^4.135.0"
  }
}
